<h3 class="editor-titulotabdos"><i class="fa fa-picture-o" aria-hidden="true"></i>Imagenes</h3>
<div class="editor-contenido-sidebar">
    <div class="col-md-12 content-image-preview-control" id="content-image-preview-control">
        <img class="control-image-preview" id="control-image-preview" src="/facturacionv8/img/logo_facturalaya_291_blanco.png" /><br />
        <button type="button" class="btn_opcion_imagen_cambiar_imagen btn btn-primary btn-raised legitRipple"><i class="icon-cog3 position-left"></i> Cambiar Imágen</button>
    </div>
    
    <div class="editor-division"></div>
    <div class="editor-grupo-form editor-url-textarea">
        <span class="editor-icon-boton"><i class="fa fa-link" aria-hidden="true"></i></span>
