<h3 class="editor-titulotabdos"><i class="fa fa-font" aria-hidden="true"></i>Texto</h3>
<div class="editor-contenido-sidebar">
    <div class="editor-grupo-form">
        <span class="editor-icon-boton"><i class="fa fa-arrows-h" aria-hidden="true"></i></span>
        <input id="demo_vertical" class="opcion-texto-anchocaja" type="text" value="20" name="demo_vertical">                    
    </div>
    <div class="editor-grupo-form">
        <span class="editor-icon-boton"><i class="fa fa-arrows-v" aria-hidden="true"></i></span>
        <input id="demo_vertical" class="opcion-texto-altocaja" type="text" value="20" name="demo_vertical">                  
    </div>
    <div class="editor-grupo-form">
        <span class="editor-icon-boton">x</span>
        <input id="demo_vertical" class="opcion-texto-marginleft" type="text" value="20" name="demo_vertical">                  
    </div>
    <div class="editor-grupo-form">
        <span class="editor-icon-boton">y</span>
        <input id="demo_vertical" class="opcion-texto-margintop" type="text" value="20" name="demo_vertical">                  
    </div>                                            
    <div class="editor-division"></div>
    <div class="editor-grupo-form editor-url-textarea">
        <span class="editor-icon-boton"><i class="fa fa-link" aria-hidden="true"></i></span>
        <textarea class="url-textarea opcion-texto-urlenlace" placeholder="https://"></textarea>                 
    </div>
    <div class="editor-grupo-form editor-form-boton">
        <button class="botonsidebar botonsidtres opcion-texto-btn-crearenlace">
            Crear Enlace
        </button>
    </div> 
    <div class="editor-division"></div>
    <div class="content-pickcolor">                                                
        <div class="sp-preview content-opciones-texto-textcolor">
            <input type="text" class="form-control colorpicker-show-input opciones-texto-textcolor" data-preferred-format="hex3" value="#f75d1c">
        </div>
    </div>
    <div class="editor-grupo-form">
        <span class="editor-icon-boton"><i class="fa fa-text-height" aria-hidden="true"></i></span>
        <input id="demo_vertical" class="opciones-texto-fontsize" type="text" value="20" name="demo_vertical">                  
    </div>
    <div class="editor-grupo-form">
        <span class="editor-icon-boton"><i class="fa fa-text-width" aria-hidden="true"></i></span>
        <input id="demo_vertical" class="opciones-texto-letterspacing" type="text" value="20" name="demo_vertical">                  
    </div>  
    <div class="editor-grupo-form editor-selectdos">
        <select class="select select2-hidden-accessible opciones-texto-font-family" tabindex="-1" aria-hidden="true">        
            <option value="Georgia, serif">Georgia, serif</option>
            <option value='"Palatino Linotype", "Book Antiqua", Palatino, serif'>Palatino, serif</option>
            <option value='"Times New Roman", Times, serif'>Times New Roman</option>
            <option value='Arial, Helvetica, sans-serif'>Arial, Helvetica, sans-serif</option>
            <option value='"Arial Black", Gadget, sans-serif'>Arial Black, Gadget, sans-serif</option>
            <option value='"Comic Sans MS", cursive, sans-serif'>Comic Sans MS, cursive, sans-serif</option>
            <option value='Impact, Charcoal, sans-serif'>Impact, Charcoal, sans-serif</option>
            <option value='"Lucida Sans Unicode", "Lucida Grande", sans-serif'>Lucida Sans Unicode, Lucida Grande, sans-serif</option>
            <option value='Tahoma, Geneva, sans-serif'>Tahoma, Geneva, sans-serif</option>
            <option value='"Trebuchet MS", Helvetica, sans-serif'>Trebuchet MS, Helvetica, sans-serif</option>
            <option value='Verdana, Geneva, sans-serif'>Verdana, Geneva, sans-serif</option>
            <option value='"Courier New", Courier, monospace'>Courier New, Courier, monospace</option>
            <option value='"Lucida Console", Monaco, monospace'>Lucida Console, Monaco, monospace</option>
        </select>
    </div>
    <div class="editor-grupo-form editor-selectdos selecttres">
        <select class="select select2-hidden-accessible opciones-texto-font-weight" tabindex="-1" aria-hidden="true">        
            <option value="normal">Regular</option>
            <option value="bold">Bold</option>
            <option value="italic">Italic</option>
        </select>
    </div>
    <div class="editor-grupo-form editor-form-boton">
        <button class="opcion-texto-left botonsidebar">
            <i class="fa fa-align-left" aria-hidden="true"></i>
        </button>
        <button class="opcion-texto-center botonsidebar">
            <i class="fa fa-align-center" aria-hidden="true"></i>
        </button>
        <button class="opcion-texto-right botonsidebar">
            <i class="fa fa-align-right" aria-hidden="true"></i>
        </button>
        <button class="opcion-texto-justify botonsidebar botonsidebarultimo">
            <i class="fa fa-align-justify" aria-hidden="true"></i>
        </button>
    </div>
    <div class="editor-grupo-form editor-selectdos selecttres">
        <select class="select select2-hidden-accessible opciones-texto-style" tabindex="-1" aria-hidden="true">
            <option value="<p>">P</option>
            <option value="<h1>">H1</option>
            <option value="<h2>">H2</option>
            <option value="<h3>">H3</option>
            <option value="<h4>">H4</option>
            <option value="<h5>">H5</option>
            <option value="<h6>">H6</option>
            <option value="<address>">ADDR</option>
            <option value="<pre>">pre</option>
        </select>
    </div>
</div>