<h3 class="editor-titulotabdos"><i class="fa fa-youtube-play" aria-hidden="true"></i>Video</h3>
<div class="editor-contenido-sidebar">
    <div class="editor-grupo-form editor-url-textarea">
        <span class="editor-icon-boton"><i class="fa fa-link" aria-hidden="true"></i></span>
        <textarea class="url-textarea opcion-video-urlvideo" placeholder="https://"></textarea>                 
    </div>
    <span class="nombre-elemnto-editor" style="display: none;">Autoplay</span>
    <div class="checkeditor chekautoplay" style="display: none;">
        <input type="checkbox" name="my-checkbox" class="opcion-video-chkautoplay" checked>
    </div>
    <div class="editor-grupo-form" style="display: none;">
        <span class="editor-icon-boton"><i class="fa fa-arrows-h" aria-hidden="true"></i></span>
        <input id="demo_vertical" type="text" value="20" name="demo_vertical">                    
    </div>
    <div class="editor-grupo-form" style="display: none;">
        <span class="editor-icon-boton"><i class="fa fa-arrows-v" aria-hidden="true"></i></span>
        <input id="demo_vertical" type="text" value="20" name="demo_vertical">                  
    </div>
    <div class="editor-grupo-form" style="display: none;">
        <span class="editor-icon-boton">x</span>
        <input id="demo_vertical" type="text" value="20" name="demo_vertical">                  
    </div>
    <div class="editor-grupo-form" style="display: none;">
        <span class="editor-icon-boton">y</span>
        <input id="demo_vertical" type="text" value="20" name="demo_vertical">                  
    </div>   
    <div class="editor-grupo-form editor-form-boton">
        <button class="botonsidebar botonsidtres opcion-video-btncambiarvideo">
            Cambiar Video
        </button>
    </div>  
</div>
<div class="editor-contenido-sidebar editor-contenido-sidebardos" style="display: none;">
    <div class="category-content no-padding">
        <ul class="navigation navigation-main navigation-accordion">
            <li> 
                <div class="checkeditor">
                    <input type="checkbox" name="my-checkbox" checked>
                </div>
                <a href="#">                                                                      
                    <span>Border</span>
                </a>
                <ul class="contenido-acordion">
                    <div class="sp-replacer sp-light sp-colorvideo-border">
                        <div class="sp-preview">
                            <input type="text" class="form-control colorpicker-show-input" data-preferred-format="hex3" value="#f75d1c">
                        </div>
                    </div>
                    <div class="editor-grupo-form editor-border-uno">      
                        <input id="demo_vertical" type="text" value="20" name="demo_vertical">
                    </div>
                    <div class="editor-grupo-form editor-form-boton editor-alineado">
                        <button class="botonsidebar">
                            <i class="fa fa-align-left" aria-hidden="true"></i>
                        </button>
                        <button class="botonsidebar">
                            <i class="fa fa-align-center" aria-hidden="true"></i>
                        </button>
                        <button class="botonsidebar">
                            <i class="fa fa-align-right" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="editor-grupo-form editor-form-boton editor-limpiar">
                        <button class="botonsidebar botonsidtres">
                            Limpiar
                        </button>
                    </div>  
                    <div class="editor-flechas">
                        <button class="botonsidebar botonflecha">
                            <i class="fa fa-window-maximize" aria-hidden="true"></i>
                        </button>
                        <button class="botonsidebar botonflecha bfdos">
                            <i class="fa fa-window-maximize" aria-hidden="true"></i>
                        </button>
                        <button class="botonsidebar botonflecha bftres">
                            <i class="fa fa-window-maximize" aria-hidden="true"></i>
                        </button>
                        <button class="botonsidebar botonflecha bfcuatro">
                            <i class="fa fa-window-maximize" aria-hidden="true"></i>
                        </button>
                        <button class="botonsidebar botonflecha bfcentro">
                            <i class="fa fa-window-maximize" aria-hidden="true"></i>
                        </button>
                    </div>
                </ul>
            </li>                                                    
        </ul>
    </div>  
</div>