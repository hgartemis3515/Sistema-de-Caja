<div class="panel" style="max-width: 1120px;margin: 0 auto;">
    <div class="panel-body">
        <div class="row justifice-content">
            <div class="col-lg-10 mt-2">
                <div class="media-left">
                    <img src=" /facturacionv8/public/img/logo_cuadrado_ejemplo.png" class="contribuyente_img_logo" style="width: 100px!important; height: 100px!important;" alt="">
                </div>

                <div class="media-body">
                    <h6 class="media-heading" id="contribuyente_text_razonsocial">Logo en Formato cuadrado</h6>
                    <span class="text-muted">Tamaño Sugerido: 150x150px</span>
                </div>
            </div>
            <div class="col-lg-2 mt-2">
                <div class="media-right media-middle">

                    <button type="button" id="btn_subirimagen" class="btn_subirimagen btn bg-indigo legitRipple"><i class="icon-box-remove mr-2"></i>Subir Logo</button>

                    <button type="button" style="display:none;" class="btn btn-primary btn-icon legitRipple" onclick="eliminar_logo('cuadrado')"><i class="icon-cancel-square2"></i></button>

                </div>
            </div>
        </div>
        <div class="row justifice-content">
            <div class="col-lg-10 mt-2">
                <div class="media">
                    <div class="media-left">
                        <img src=" /facturacionv8/public/img/logo_rectangular_ejemplo.png" class="img_logo350x167" alt="img_logo350x167">
                    </div>

                    <div class="media-body">
                        <h6 class="media-heading" id="contribuyente_text_razonsocial">Logo en Formato Rectángular</h6>
                        <span class="text-muted">Tamaño Sugerido: 350x167px</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-2 mt-2">
                <div class="media">
                    <div class="media-right media-middle">
                        <button type="button" class="btn_subirimagen_350_167 btn bg-indigo legitRipple"><i class="icon-box-remove mr-2"></i>Subir Logo</button>

                        <button type="button" style="display:none;" class="btn btn-primary btn-icon legitRipple" onclick="eliminar_logo('cuadrado')"><i class="icon-cancel-square2"></i></button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>