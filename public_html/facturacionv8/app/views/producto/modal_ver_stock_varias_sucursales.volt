<!-- Ver Stock en Diferentes Sucursales -->
<div id="vm_stock_varias_sucursales" class="modal fade" tabindex="-1">
	<div class="modal-dialog modal-lg">
		<div class="modal-content" id="content_vm_stock_varias_sucursales">
			<div class="modal-header bg-info">
				<button type="button" class="close" data-dismiss="modal">&times;</button>
				<h6 class="modal-title"> <i class="icon-minus-circle2"></i> &nbsp; Stock en las Diferentes Sucursales</h6>
			</div>
	
			<div class="modal-body">
				<div class="row">
                    <div class="col-md-12 table-responsive">
                        <table id="vm_stock_varias_sucursales_tbl_lista" class="table">
                            <thead>
                                <tr>
                                    <td>IdSucursal</td>
                                    <td>Sucursal</td>
                                    <td>Código Producto</td>
                                    <td>Producto</td>
                                    <td>Stock Actual</td>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>
                </div>
			</div>
	
			<div class="modal-footer">
				<button type="button" class="btn btn-default mr-2" data-dismiss="modal">Cerrar</button>
			</div>
		</div>
	</div>
</div>
<!-- /Ver Stock en Diferentes Sucursales -->