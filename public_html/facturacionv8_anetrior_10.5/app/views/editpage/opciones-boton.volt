<h3 class="editor-titulotabdos"><i class="fa fa-square" aria-hidden="true"></i>Botón</h3>
<div class="editor-contenido-sidebar">                                            
    <div class="editor-grupo-form">
        <span class="editor-icon-boton"><i class="fa fa-arrows-h" aria-hidden="true"></i></span>
        <input id="demo_vertical" class="opcion-boton-anchocaja" type="text" value="20" name="demo_vertical">                    
    </div>
    <div class="editor-grupo-form">
        <span class="editor-icon-boton"><i class="fa fa-arrows-v" aria-hidden="true"></i></span>
        <input id="demo_vertical" class="opcion-boton-altocaja" type="text" value="20" name="demo_vertical">                  
    </div>
    <div class="editor-grupo-form">
        <span class="editor-icon-boton">x</span>
        <input id="demo_vertical" class="opcion-boton-marginleft" type="text" value="20" name="demo_vertical">                  
    </div>
    <div class="editor-grupo-form">
        <span class="editor-icon-boton">y</span>
        <input id="demo_vertical" class="opcion-boton-margintop" type="text" value="20" name="demo_vertical">                  
    </div>  
    <span class="nombre-elemnto-editor needit">Etiqueta</span>
    <div class="editor-grupo-form editor-url-video nombre-boton">
        <span class="editor-icon-boton"><i class="fa fa-tag" aria-hidden="true"></i></span>
        <input class="url-video opcion-boton-label" type="text" placeholder="¡Comprar Ahora!" />                    
    </div>
</div>
<div class="editor-contenido-sidebar editor-contenido-sidebardos">
    <div class="category-content no-padding">
        <ul class="navigation navigation-main navigation-accordion">
            <li class="active"> 
                <a href="#">                                                                      
                    <span>Tipografía</span>
                </a>
                <ul class="contenido-acordion">
                    <div class="sp-replacer sp-light sp-colorboton-tipografia">
                        <div class="sp-preview content-opcion-boton-textcolor">
                            <input type="text" class="form-control colorpicker-show-input opcion-boton-colortexto" data-preferred-format="hex3" value="#f75d1c">
                        </div>
                    </div>
                    <div class="editor-grupo-form">
                        <span class="editor-icon-boton"><i class="fa fa-text-height" aria-hidden="true"></i></span>
