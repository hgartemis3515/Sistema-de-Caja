# Copiar a .env y ajustar credenciales.
# Desarrollo local (PHP embebido + MySQL en Windows/XAMPP, sin Docker):
WEB_PORT=8080

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_PASSWORD=
DB_NAME=facturacion_local

# Con iniciar.bat (router-dev-server.php) deja «/». Las vistas usan /facturacionv8/... y el router lo normaliza.
APP_BASE_URI=/

# Primera vez MySQL: crea la base DB_NAME luego ejecuta importar-min-mysql.bat
# (genera tablas desde modelos + usuario admin@local.test / Admin123).

# Si usas docker-compose.yml en esta carpeta, define también en .env:
# MYSQL_ROOT_PASSWORD=...
# MYSQL_DATABASE=facturacion_local
# MYSQL_USER=factura
# MYSQL_PASSWORD=...
# MYSQL_PORT=3307
