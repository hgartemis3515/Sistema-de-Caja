# Copiar a .env y ajustar
MYSQL_ROOT_PASSWORD=rootlocal
MYSQL_DATABASE=facturacion_local
MYSQL_USER=factura
MYSQL_PASSWORD=factura_local
MYSQL_PORT=3307
WEB_PORT=8080

# MySQL (una sola fuente de puerto: no pongas DB_PORT=3306 y MYSQL_PORT=3307 a la vez)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=factura
DB_PASS=
# alternativa a DB_PASS:
DB_PASSWORD=
DB_NAME=facturacion_local

# Solo RUTA para Phalcon (ej. /). Si pones URL completa, se convierte a ruta.
APP_BASE_URI=/
